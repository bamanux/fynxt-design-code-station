# Copy to .env and fill in. .env is git-ignored — never commit real keys.
ANTHROPIC_API_KEY=
# Path to the governance repo (case files, tokens.json, registry). Relative paths resolve from this repo root.
ENGINE_PATH=../fynxt-product-experience-engine
# Model FDI runs on, and a hard spend cap per run (USD).
FDI_MODEL=claude-opus-5-5
FDI_MAX_BUDGET_USD=10
# Studio server port (production `npm start`). Dev uses Vite on 5190.
PORT=5191
# ---- Sign-in -------------------------------------------------------------------
# "entra" = Microsoft 365 sign-in (required for production; `npm start` refuses anything else).
# Leave empty for development sign-in (email only, no password; local machine only).
STUDIO_AUTH_MODE=
# Only addresses at this domain can sign in.
STUDIO_ALLOWED_DOMAIN=fynxt.com
# First Admins (comma-separated). They can sign in without an invite and then invite everyone else.
STUDIO_ADMINS=
# Microsoft Entra ID app registration (Azure portal › App registrations):
#   - Redirect URI (Web): <STUDIO_PUBLIC_URL>/api/auth/callback
#   - Supported accounts: this organisation only (single tenant)
#   - A client secret
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Public origin users open, e.g. https://fdi.fynxt.com (used for the redirect URI; https turns on Secure cookies).
STUDIO_PUBLIC_URL=http://127.0.0.1:5190
# Long random string that signs session cookies, e.g. `openssl rand -hex 32`. Required with entra.
STUDIO_SESSION_SECRET=
